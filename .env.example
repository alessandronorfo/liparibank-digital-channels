# Template delle variabili d'ambiente: copialo in .env e completa i valori.
# .env non va mai committato (è in .gitignore).

# Database: letti da docker-compose.yml
POSTGRES_USER=liparibank
POSTGRES_PASSWORD=
POSTGRES_DB=liparibank

# Applicazione: lette e validate all'avvio da src/config/env.ts
# Obbligatoria: senza, l'applicazione non parte
DATABASE_URL="postgresql://liparibank:password@localhost:5432/liparibank"
# Facoltativa, predefinita 3000
PORT=3000
# development | test | production
NODE_ENV=development
# URL del frontend React autorizzato a chiamare le API (CORS)
CORS_ORIGIN=http://localhost:5173
