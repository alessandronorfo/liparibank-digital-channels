# Template delle variabili d'ambiente: copialo in .env e completa i valori.
# .env non va mai committato (è in .gitignore).

# Database: letti da docker-compose.yml
POSTGRES_USER=liparibank
POSTGRES_PASSWORD=
POSTGRES_DB=liparibank

# Applicazione
DATABASE_URL="postgresql://liparibank:password@localhost:5432/liparibank"
PORT=3000
NODE_ENV=development
